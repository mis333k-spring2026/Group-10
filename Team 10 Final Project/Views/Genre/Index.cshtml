@model IEnumerable<Team10FinalProject.Models.Genre>

@{
    ViewData["Title"] = "Genres";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Genres</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>Genre ID</th>
            <th>@Html.DisplayNameFor(model => model.GenreName)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="color:#555;">@item.GenreID</td>
                <td class="fw-semibold" style="color:#555;">@item.GenreName</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.GenreID"
                       class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>