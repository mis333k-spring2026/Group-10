@model IEnumerable<Team10FinalProject.ViewModels.SongSalesViewModel>
@{
    ViewData["Title"] = "All Songs Sold";
}

<div class="d-flex align-items-center justify-content-between mb-1">
    <h2 class="fw-bold mb-0" style="color:#333F48;">All Songs Sold</h2>
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">← Back to Reports</a>
</div>
<p class="text-muted mb-4">
    Individual song purchases only &mdash; displaying <strong>@ViewBag.RecordCount</strong> record(s)
</p>
<hr style="border-color:#E8D5C4;" />

@if (!Model.Any())
{
    <div class="card border p-4 text-center" style="border-color:#E8D5C4; background-color:#F8F0E8;">
        <p class="text-muted mb-0">No song sales data available yet.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>@Html.DisplayNameFor(m => m.SongTitle)</th>
                <th>@Html.DisplayNameFor(m => m.ArtistName)</th>
                <th class="text-center">@Html.DisplayNameFor(m => m.PurchaseCount)</th>
                <th class="text-end">@Html.DisplayNameFor(m => m.Revenue)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold" style="color:#555;">@item.SongTitle</td>
                    <td style="color:#9D4700;">@item.ArtistName</td>
                    <td class="text-center" style="color:#555;">@item.PurchaseCount</td>
                    <td class="text-end" style="color:#BF5700;">@item.Revenue.ToString("C")</td>
                </tr>
            }
        </tbody>
        <tfoot style="background-color:#E8D5C4;">
            <tr>
                <td colspan="2" class="fw-bold" style="color:#333F48;">Totals</td>
                <td class="text-center fw-bold" style="color:#333F48;">@Model.Sum(m => m.PurchaseCount)</td>
                <td class="text-end fw-bold" style="color:#BF5700;">@Model.Sum(m => m.Revenue).ToString("C")</td>
            </tr>
        </tfoot>
    </table>
}