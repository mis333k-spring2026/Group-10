@model IEnumerable<Team10FinalProject.ViewModels.SongSalesViewModel>
@{
    ViewData["Title"] = "All Songs Sold";
}

<div class="d-flex align-items-center justify-content-between mb-1">
    <h2 class="mb-0">All Songs Sold</h2>
    <a asp-action="Index" class="btn btn-outline-primary btn-sm">← Back to Reports</a>
</div>
<p class="text-muted mb-4">
    Individual song purchases only &mdash; displaying <strong>@ViewBag.RecordCount</strong> record(s)
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No song sales data available yet.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-bordered mb-0">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(m => m.SongTitle)</th>
                        <th>@Html.DisplayNameFor(m => m.ArtistName)</th>
                        <th class="text-center">@Html.DisplayNameFor(m => m.PurchaseCount)</th>
                        <th class="text-end">@Html.DisplayNameFor(m => m.Revenue)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SongTitle</td>
                            <td>@item.ArtistName</td>
                            <td class="text-center">@item.PurchaseCount</td>
                            <td class="text-end">@item.Revenue.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot style="background-color: #E8D5C4; font-weight: 700;">
                    <tr>
                        <td colspan="2">Totals</td>
                        <td class="text-center">@Model.Sum(m => m.PurchaseCount)</td>
                        <td class="text-end">@Model.Sum(m => m.Revenue).ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
