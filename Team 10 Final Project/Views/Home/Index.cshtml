@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        background: linear-gradient(135deg, #333F48 0%, #4a5a66 45%, #3d4f5c 100%);
        padding: 4.5rem 2rem 4rem;
        border-radius: 16px;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 12% 70%, rgba(191,87,0,0.22) 0%, transparent 50%),
            radial-gradient(ellipse at 88% 20%, rgba(157,71,0,0.14) 0%, transparent 45%);
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.1;
    }

    .hero-title em {
        font-style: normal;
        color: #E8D5C4;
    }

    .hero-sub {
        color: rgba(255,255,255,0.78);
        font-size: 1rem;
        line-height: 1.65;
        max-width: 540px;
    }

    .section-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #333F48;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title::before {
        content: '';
        display: inline-block;
        width: 3px;
        height: 1.1em;
        background: linear-gradient(180deg, #BF5700, #9D4700);
        border-radius: 2px;
        flex-shrink: 0;
    }

    .featured-banner {
        background: linear-gradient(135deg, #333F48 0%, #4a5a66 60%, #3d4f5c 100%);
        border-radius: 14px;
        padding: 2rem 2.25rem;
        display: flex;
        align-items: center;
        gap: 1.75rem;
        margin-bottom: 2rem;
    }

    .featured-icon {
        flex-shrink: 0;
        width: 80px;
        height: 80px;
        border-radius: 12px;
        background: linear-gradient(135deg, #BF5700, #E8D5C4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
    }

    .featured-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.2rem;
    }

    .featured-sub {
        color: rgba(255,255,255,0.75);
        font-size: 14px;
        margin-bottom: 0.5rem;
    }

    .quick-link-card {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        padding: 1rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 15px;
        text-decoration: none;
        color: #fff;
        background: linear-gradient(135deg, #BF5700, #9D4700);
        border: none;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        box-shadow: 0 4px 14px rgba(191,87,0,0.2);
    }

    .quick-link-card:hover {
        color: #fff;
        text-decoration: none;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(191,87,0,0.3);
    }

    .quick-link-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 12px;
    }

    .section-divider {
        border-color: #E8D5C4;
    }

    .cta-banner {
        background: linear-gradient(135deg, #333F48 0%, #4a5a66 60%, #BF5700 100%);
        border-radius: 14px;
        padding: 2.75rem 2.5rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .cta-sub {
        color: rgba(255,255,255,0.78);
    }

    @@media (max-width: 768px) {
        .featured-banner {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<!-- Hero -->
<section class="hero">
    <div class="hero-inner">
        <h1 class="hero-title mb-3">Welcome to <em>Bevo's Tunes</em></h1>
        <p class="hero-sub mb-4">
            Buy songs and full albums, then keep them in your personal library.
            Browse artists, explore albums, and build your collection.
        </p>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Song" asp-action="Index" class="btn btn-light fw-semibold px-4">&#9835; Browse Songs</a>
                <a asp-controller="Album" asp-action="Index" class="btn btn-outline-light px-4">View Albums</a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-light fw-semibold px-4">&#9835; Get Started</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light px-4">Sign In</a>
            }
        </div>
    </div>
</section>

<!-- Featured Banner -->
<div class="featured-banner">
    <div class="featured-icon">&#9835;</div>
    <div class="flex-grow-1">
        <span class="badge mb-2 px-2 py-1" style="background:#BF5700; font-size:10px; letter-spacing:.1em;">
            &#9733; FEATURED NOW
        </span>
        <h2 class="featured-title">Welcome to Bevo's Tunes</h2>
        <p class="featured-sub">Explore songs, albums, and artists from one place.</p>
        <span class="text-warning">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="fw-bold ms-2" style="color:#E8D5C4;">Music Marketplace</span>
    </div>
    <div>
        <a asp-controller="Song" asp-action="Index" class="btn btn-light fw-semibold px-4">Browse Songs</a>
    </div>
</div>

<hr class="section-divider my-2" />

<!-- Role-based quick links -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <div class="py-4">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            @if (User.IsInRole("Admin"))
            {
                <h2 class="section-title mb-0">Admin Quick Links</h2>
            }
            else
            {
                <h2 class="section-title mb-0">My Account</h2>
            }
        </div>

        <div class="quick-link-grid">
            <a asp-action="Index" asp-controller="Courses" class="quick-link-card">Courses</a>
            <a asp-action="Index" asp-controller="Registrations" class="quick-link-card">Registrations</a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Index" asp-controller="Departments" class="quick-link-card">Departments</a>
                <a asp-action="Index" asp-controller="RoleAdmin" class="quick-link-card">Manage Users</a>
            }
        </div>
    </div>

    <hr class="section-divider my-2" />
}

<!-- CTA for guests -->
@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <div class="cta-banner">
        <h2 class="fw-bold text-white mb-2">Ready to Build Your Library?</h2>
        <p class="mb-4 cta-sub">Create an account and start building your Bevo's Tunes collection.</p>
        <a asp-controller="Account" asp-action="Register" class="btn btn-light fw-semibold px-5">
            &#9835; Get Started
        </a>
    </div>
}