@{
    ViewData["Title"] = "Home";
}

<style>
    .hero {
        background-color: #BF5700;
        padding: 5rem 2.5rem 4.5rem;
        border-radius: 20px;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse at 10% 80%, rgba(255,255,255,0.06) 0%, transparent 50%),
            radial-gradient(ellipse at 90% 10%, rgba(255,255,255,0.04) 0%, transparent 50%);
        pointer-events: none;
    }

    .hero-inner {
        position: relative;
        z-index: 1;
    }

    .hero-eyebrow {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.65);
        margin-bottom: 1rem;
    }

    .hero-title {
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.08;
        letter-spacing: -0.02em;
        margin-bottom: 1.25rem;
    }

    .hero-title span {
        color: #F8F0E8;
        opacity: 0.85;
    }

    .hero-sub {
        color: rgba(255,255,255,0.78);
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 500px;
        margin-bottom: 2rem;
    }

    .btn-hero-primary {
        background-color: #fff;
        color: #BF5700;
        font-weight: 700;
        border: none;
        padding: 0.65rem 1.75rem;
        border-radius: 8px;
        font-size: 15px;
        transition: background 0.15s, color 0.15s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-hero-primary:hover {
        background-color: #F8F0E8;
        color: #9D4700;
        text-decoration: none;
    }

    .btn-hero-outline {
        background-color: transparent;
        color: #fff;
        font-weight: 600;
        border: 1.5px solid rgba(255,255,255,0.5);
        padding: 0.65rem 1.75rem;
        border-radius: 8px;
        font-size: 15px;
        transition: border-color 0.15s, background 0.15s;
        text-decoration: none;
        display: inline-block;
    }

    .btn-hero-outline:hover {
        border-color: #fff;
        background-color: rgba(255,255,255,0.08);
        color: #fff;
        text-decoration: none;
    }

    .featured-banner {
        background-color: #F8F0E8;
        border: 1.5px solid #E8D5C4;
        border-radius: 16px;
        padding: 2rem 2.25rem;
        display: flex;
        align-items: center;
        gap: 1.75rem;
        margin-bottom: 2rem;
    }

    .featured-icon {
        flex-shrink: 0;
        width: 72px;
        height: 72px;
        border-radius: 12px;
        background-color: #BF5700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        font-weight: 700;
        color: white;
    }

    .featured-eyebrow {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #BF5700;
        margin-bottom: 0.35rem;
    }

    .featured-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 0.2rem;
    }

    .featured-sub {
        color: #999;
        font-size: 14px;
        margin-bottom: 0;
    }

    .section-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #BF5700;
        margin-bottom: 0.4rem;
    }

    .section-heading {
        font-size: 1.2rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 1rem;
    }

    .nav-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.25rem 1.5rem;
        border-radius: 12px;
        background-color: #F8F0E8;
        border: 1.5px solid #E8D5C4;
        text-decoration: none;
        transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
        height: 100%;
    }

    .nav-card:hover {
        border-color: #BF5700;
        box-shadow: 0 4px 16px rgba(191,87,0,0.12);
        transform: translateY(-2px);
        text-decoration: none;
    }

    .nav-card-title {
        font-size: 15px;
        font-weight: 700;
        color: #555;
        margin-bottom: 2px;
    }

    .nav-card-sub {
        font-size: 12px;
        color: #999;
        margin: 0;
    }

    .nav-card-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: #BF5700;
        margin-bottom: 0.75rem;
    }

    .divider {
        border-color: #E8D5C4;
        margin: 1.5rem 0;
    }

    .cta-banner {
        background-color: #BF5700;
        border-radius: 16px;
        padding: 3rem 2.5rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .cta-title {
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 800;
        color: #fff;
        margin-bottom: 0.75rem;
    }

    .cta-sub {
        color: rgba(255,255,255,0.78);
        font-size: 1rem;
        margin-bottom: 1.75rem;
    }

    @@media (max-width: 768px) {
        .featured-banner { flex-direction: column; text-align: center; }
    }
</style>

<!-- Hero -->
<section class="hero">
    <div class="hero-inner d-flex align-items-center gap-4">
        <div class="flex-grow-1">
            <p class="hero-eyebrow">Bevo's Tunes — Texas Music Store</p>
            <h1 class="hero-title">Your Music,<br /><span>Owned Forever.</span></h1>
            <p class="hero-sub">
                Buy songs and full albums, then keep them in your personal library.
                Browse artists, explore albums, and build your collection.
            </p>
            <div class="d-flex gap-3 flex-wrap">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Song" asp-action="Index" class="btn-hero-primary">Browse Songs</a>
                    <a asp-controller="Album" asp-action="Index" class="btn-hero-outline">View Albums</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Get Started</a>
                    <a asp-controller="Account" asp-action="Login" class="btn-hero-outline">Sign In</a>
                }
            </div>
        </div>
        <div class="d-none d-md-block" style="flex: 0 0 600px;">
            <img src="~/images/vinyl.png" alt="Vinyl record player"
                style="width:100%; max-height:600px; object-fit:contain; filter: invert(1);" />
        </div>
    </div>
</section>

<!-- Featured Banner -->
<div class="featured-banner">
    <div class="featured-icon">BT</div>
    <div class="flex-grow-1">
        <p class="featured-eyebrow">Featured Now</p>
        <h2 class="featured-title">Welcome to Bevo's Tunes</h2>
        <p class="featured-sub">Explore songs, albums, and artists from one place.</p>
    </div>
    <div>
        <a asp-controller="Song" asp-action="Index" class="btn btn-primary fw-semibold px-4">Browse Songs</a>
    </div>
</div>

<!-- Browse — available to everyone -->
<div class="mb-4">
    <p class="section-label">Browse</p>
    <h2 class="section-heading">Music</h2>

    <!-- Search as its own wide row -->
    <div class="row g-3 mb-3">
        <div class="col-12">
            <a asp-controller="Search" asp-action="Index" class="nav-card text-center" style="padding: 1.5rem;">
                <i class="bi bi-search" style="color:#BF5700; font-size:1.2rem;"></i>
                <p class="nav-card-title">Search</p>
                <p class="nav-card-sub">Search music</p>
            </a>
        </div>
    </div>

    <!-- Songs, Albums, Artists below -->
    <div class="row g-3">
        <div class="col-4">
            <a asp-controller="Song" asp-action="Index" class="nav-card">
                <i class="bi bi-music-note" style="color:#BF5700; font-size:1.2rem;"></i>
                <p class="nav-card-title">Songs</p>
                <p class="nav-card-sub">Browse catalog</p>
            </a>
        </div>
        <div class="col-4">
            <a asp-controller="Album" asp-action="Index" class="nav-card">
                <i class="bi bi-vinyl" style="color:#BF5700; font-size:1.2rem;"></i>
                <p class="nav-card-title">Albums</p>
                <p class="nav-card-sub">Browse all albums</p>
            </a>
        </div>
        <div class="col-4">
            <a asp-controller="Artist" asp-action="Index" class="nav-card">
                <i class="bi bi-mic" style="color:#BF5700; font-size:1.2rem;"></i>
                <p class="nav-card-title">Artists</p>
                <p class="nav-card-sub">Browse all artists</p>
            </a>
        </div>
    </div>
</div>

<!-- Logged-in customer links -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <hr class="divider" />

    <div class="mb-4">
        <p class="section-label">My Account</p>
        <h2 class="section-heading">Library</h2>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a asp-controller="MyMusic" asp-action="Index" class="nav-card">
                    <div class="nav-card-dot"></div>
                    <p class="nav-card-title">My Music</p>
                    <p class="nav-card-sub">Your personal library</p>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Order" asp-action="Index" class="nav-card">
                    <div class="nav-card-dot"></div>
                    <p class="nav-card-title">Cart</p>
                    <p class="nav-card-sub">View shopping cart</p>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="OrderHistory" asp-action="Index" class="nav-card">
                    <div class="nav-card-dot"></div>
                    <p class="nav-card-title">Order History</p>
                    <p class="nav-card-sub">Past purchases</p>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a asp-controller="Account" asp-action="Index" class="nav-card">
                    <div class="nav-card-dot"></div>
                    <p class="nav-card-title">Account</p>
                    <p class="nav-card-sub">Manage your account</p>
                </a>
            </div>
        </div>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Employee") || User.IsInRole("Manager"))
    {
        <hr class="divider" />

        <div class="mb-4">
            <p class="section-label">Staff</p>
            <h2 class="section-heading">Management</h2>

            <div class="row g-3">

                <div class="col-6 col-md-3">
                    <a asp-controller="RoleAdmin" asp-action="Index" class="nav-card">
                        <div class="nav-card-dot"></div>
                        <p class="nav-card-title">Manage Users</p>
                        <p class="nav-card-sub">User role management</p>
                    </a>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-controller="Account" asp-action="AddUser" class="nav-card">
                        <div class="nav-card-dot"></div>
                        <p class="nav-card-title">Add User</p>
                        <p class="nav-card-sub">Create staff/customer account</p>
                    </a>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-controller="Promotion" asp-action="Index" class="nav-card">
                        <div class="nav-card-dot"></div>
                        <p class="nav-card-title">Promotions</p>
                        <p class="nav-card-sub">Manage promotions</p>
                    </a>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-controller="Song" asp-action="Create" class="nav-card">
                        <div class="nav-card-dot"></div>
                        <p class="nav-card-title">Add Song</p>
                        <p class="nav-card-sub">Add new song</p>
                    </a>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-controller="Album" asp-action="Create" class="nav-card">
                        <div class="nav-card-dot"></div>
                        <p class="nav-card-title">Add Album</p>
                        <p class="nav-card-sub">Add new album</p>
                    </a>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-controller="ReviewModeration" asp-action="Index"
                    class="btn btn-outline-primary w-100">
                        Review Moderation
                    </a>
                </div>

            </div>
        </div>
    }
}

<!-- CTA for guests -->
@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <hr class="divider" />
    <div class="cta-banner">
        <h2 class="cta-title">Ready to Build Your Library?</h2>
        <p class="cta-sub">Create an account and start building your Bevo's Tunes collection.</p>
        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Get Started</a>
    </div>
}