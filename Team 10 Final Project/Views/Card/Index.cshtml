@model IEnumerable<Team10FinalProject.Models.Card>

<h1>My Cards</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Card</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Card</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var card in Model)
    {
        <tr>
            <td>@card.MaskedCardNumber</td>
            <td>@card.CardType</td>
            <td>
                <a asp-action="Edit" asp-route-id="@card.CardID" class="btn btn-warning btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@card.CardID" class="btn btn-danger btn-sm">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>