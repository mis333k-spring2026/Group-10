@model Team10FinalProject.Models.Card

@{
    ViewData["Title"] = "Delete Card";
}

<h1>Delete Card</h1>

<h4>Are you sure you want to remove this card?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">
            Card
        </dt>
        <dd class="col-sm-9">
            @Model.MaskedCardNumber
        </dd>

        <dt class="col-sm-3">
            Card Type
        </dt>
        <dd class="col-sm-9">
            @Model.CardType
        </dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.CardID" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>