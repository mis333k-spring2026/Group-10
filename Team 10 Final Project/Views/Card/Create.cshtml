@model Card
@{
    ViewData["Title"] = "Add a Card";
}
<h1>Add a Card</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CardNumber" class="control-label"></label>
                <input asp-for="CardNumber" class="form-control" maxlength="16" />
                <span asp-validation-for="CardNumber" class="text-danger"></span>
                <small class="form-text text-muted">
                    Card type is detected automatically.
                    Visa starts with 4, MasterCard starts with 54,
                    Discover starts with 6, Amex is 15 digits.
                </small>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save Card" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to My Cards</a> |
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
