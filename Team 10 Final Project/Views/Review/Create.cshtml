@model Review

@{
    ViewData["Title"] = "Write Review";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Write a Review</h2>
<hr style="border-color:#E8D5C4;" />

<div class="row">
    <div class="col-md-6">
        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="SongID" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Rating" class="form-label text-muted"></label>
                    <input asp-for="Rating" class="form-control" min="1" max="5" />
                    <span asp-validation-for="Rating" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ReviewText" class="form-label text-muted"></label>
                    <textarea asp-for="ReviewText" class="form-control" maxlength="100"></textarea>
                    <span asp-validation-for="ReviewText" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}