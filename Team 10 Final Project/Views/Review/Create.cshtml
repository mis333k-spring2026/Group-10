@model Review

@{
    ViewData["Title"] = "Write Review";
}

<h1>Write Review</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="SongID" type="hidden" />

            <div class="form-group mb-2">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" min="1" max="5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ReviewText" class="control-label"></label>
                <textarea asp-for="ReviewText" class="form-control" maxlength="100"></textarea>
                <span asp-validation-for="ReviewText" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Submit Review</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}