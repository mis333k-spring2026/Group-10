@model IEnumerable<Team10FinalProject.Models.Review>

@{
    ViewData["Title"] = "All Reviews";
}

<h1>All Reviews</h1>

<p><strong>Total Records:</strong> @Model.Count()</p>

<table class="table">
    <thead>
        <tr>
            <th>Song</th>
            <th>Reviewer</th>
            <th>Rating</th>
            <th>Review Text</th>
            <th>Approved</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var review in Model)
    {
        <tr>
            <td>@review.Song?.SongName</td>
            <td>@review.Reviewer?.Email</td>
            <td>@review.Rating</td>
            <td>@review.ReviewText</td>
            <td>@review.Status</td>
        </tr>
    }
    </tbody>
</table>