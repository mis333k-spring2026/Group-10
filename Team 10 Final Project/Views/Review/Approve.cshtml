@model IEnumerable<Review>

@{
    ViewData["Title"] = "Approve Reviews";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Pending Reviews</h2>
<hr style="border-color:#E8D5C4;" />

@if (!Model.Any())
{
    <div class="card border p-4 text-center" style="border-color:#E8D5C4; background-color:#F8F0E8;">
        <p class="text-muted mb-0">There are no pending reviews.</p>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>Song</th>
                <th>Reviewer</th>
                <th>Rating</th>
                <th>Review</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var review in Model)
            {
                <tr>
                    <td class="fw-semibold" style="color:#555;">@review.Song?.SongName</td>
                    <td style="color:#555;">@review.Reviewer?.FirstName @review.Reviewer?.LastName</td>
                    <td style="color:#BF5700;">@review.Rating</td>
                    <td style="color:#555;">@review.ReviewText</td>
                    <td>
                        <a asp-action="ApproveReview"
                           asp-route-id="@review.ReviewID"
                           class="btn btn-sm btn-primary">Approve</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}