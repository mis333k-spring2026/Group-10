@model RoleEditModel
@{
    ViewBag.Title = "Edit Role";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Edit Role: @Model.Role.Name</h2>
<hr style="border-color:#E8D5C4;" />

@Html.ValidationSummary()

@using (Html.BeginForm())
{
    <input type="hidden" name="roleName" value="@Model.Role.Name" />

    <div class="card border mb-4 p-4" style="border-color:#E8D5C4; background-color:#fff;">
        <h5 class="fw-semibold mb-3" style="color:#BF5700;">Add to @Model.Role.Name</h5>
        <table class="table table-striped table-hover align-middle">
            @if (Model.RoleNonMembers.Count() == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted text-center">All Users Are Members</td>
                </tr>
            }
            else
            {
                <thead>
                    <tr style="background-color:#BF5700; color:#fff;">
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Add to Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AppUser user in Model.RoleNonMembers)
                    {
                        <tr>
                            <td style="color:#555;">@user.FirstName</td>
                            <td style="color:#555;">@user.LastName</td>
                            <td style="color:#555;">@user.Id</td>
                            <td style="color:#555;">@user.UserName</td>
                            <td>
                                <input type="checkbox" name="IdsToAdd" value="@user.Id" />
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>

    <div class="card border mb-4 p-4" style="border-color:#E8D5C4; background-color:#fff;">
        <h5 class="fw-semibold mb-3" style="color:#BF5700;">Remove from @Model.Role.Name</h5>
        <table class="table table-striped table-hover align-middle">
            @if (Model.RoleMembers.Count() == 0)
            {
                <tr>
                    <td colspan="5" class="text-muted text-center">No Users Are Members</td>
                </tr>
            }
            else
            {
                <thead>
                    <tr style="background-color:#BF5700; color:#fff;">
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>ID</th>
                        <th>Email</th>
                        <th>Remove From Role</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AppUser user in Model.RoleMembers)
                    {
                        <tr>
                            <td style="color:#555;">@user.FirstName</td>
                            <td style="color:#555;">@user.LastName</td>
                            <td style="color:#555;">@user.Id</td>
                            <td style="color:#555;">@user.UserName</td>
                            <td>
                                <input type="checkbox" name="IdsToDelete" value="@user.Id" />
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
}