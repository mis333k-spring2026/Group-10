@{
    ViewData["Title"] = "Create Role";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Create Role</h2>
<hr style="border-color:#E8D5C4;" />

<div class="row">
    <div class="col-md-5">
        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label for="name" class="form-label text-muted">Role Name</label>
                    <input type="text" name="name" class="form-control" required />
                </div>

                <input type="submit" value="Create Role" class="btn btn-primary" />
            </form>
        </div>
    </div>
</div>

<div class="d-flex gap-3 mt-3">
    <a asp-action="Index" style="color:#BF5700;">Back to Roles</a>
    <a asp-controller="Home" asp-action="Index" style="color:#BF5700;">Home</a>
</div>