@model IEnumerable<RoleEditModel>
@{
    ViewData["Title"] = "Manage Roles";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Manage Roles</h2>
<hr style="border-color:#E8D5C4;" />

<a asp-action="Create" class="btn btn-primary mb-4">Create New Role</a>

@foreach (var role in Model)
{
    <div class="card border mb-4 p-4" style="border-color:#E8D5C4; background-color:#fff;">
        <h5 class="fw-bold mb-3" style="color:#BF5700;">@role.Role.Name</h5>

        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr style="background-color:#BF5700; color:#fff;">
                    <th>Members</th>
                    <th>Non-Members</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="color:#555;">
                        @foreach (var user in role.RoleMembers)
                        {
                            <p class="mb-1">@user.Email</p>
                        }
                    </td>
                    <td style="color:#555;">
                        @foreach (var user in role.RoleNonMembers)
                        {
                            <p class="mb-1">@user.Email</p>
                        }
                    </td>
                </tr>
            </tbody>
        </table>

        <a asp-action="Edit" asp-route-id="@role.Role.Id" style="color:#BF5700;">Edit Members</a>
    </div>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>