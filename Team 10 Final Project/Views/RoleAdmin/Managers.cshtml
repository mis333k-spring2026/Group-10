@model IEnumerable<Team10FinalProject.Models.AppUser>

@{
    ViewData["Title"] = "Managers";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Managers</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Address</th>
            <th>Zip Code</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:#555;">@user.FirstName</td>
                <td class="fw-semibold" style="color:#555;">@user.LastName</td>
                <td style="color:#555;">@user.Email</td>
                <td style="color:#555;">@user.PhoneNumber</td>
                <td style="color:#555;">@user.Address</td>
                <td style="color:#555;">@user.ZipCode</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" style="color:#BF5700;">Back to Role Admin</a>