@model IEnumerable<Team10FinalProject.Models.AppUser>

@{
    ViewData["Title"] = "Managers";
}

<h1>Managers</h1>

<p><strong>Total Records:</strong> @Model.Count()</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Phone Number</th>
            <th>Address</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FirstName</td>
            <td>@user.LastName</td>
            <td>@user.Email</td>
            <td>@user.PhoneNumber</td>
            <td>@user.Address</td>
        </tr>
    }
    </tbody>
</table>

<div>
    <a asp-action="Index">Back to Role Admin</a>
</div>