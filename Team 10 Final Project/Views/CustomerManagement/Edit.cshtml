@using Team10FinalProject.ViewModels
@model EditCustomerByEmployeeViewModel

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-7">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold mb-0" style="color:#333F48;">Edit Customer</h2>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to List</a>
        </div>

        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <form asp-action="Edit" asp-route-id="@Model.UserID" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="UserID" />
                <input type="hidden" asp-for="OriginalEmail" />

                <h5 class="fw-semibold mb-3" style="color:#BF5700;">Account Info</h5>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-muted"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                    <div class="form-text text-muted">Email address cannot be changed.</div>
                </div>

                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="Status" class="form-check-label">Account Enabled</label>
                    </div>
                    <div class="form-text text-muted">Uncheck to disable this customer's account.</div>
                </div>

                <hr style="border-color:#E8D5C4;" />
                <h5 class="fw-semibold mb-3" style="color:#BF5700;">Personal Info</h5>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label text-muted"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label text-muted"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label text-muted"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label text-muted"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ZipCode" class="form-label text-muted"></label>
                    <input asp-for="ZipCode" class="form-control" />
                    <span asp-validation-for="ZipCode" class="text-danger small"></span>
                    <div class="form-text text-muted">City and state are resolved automatically from the zip code.</div>
                </div>

                <hr style="border-color:#E8D5C4;" />
                <h5 class="fw-semibold mb-1" style="color:#BF5700;">Reset Password</h5>
                <p class="text-muted small mb-3">Leave blank to keep the current password.</p>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label text-muted"></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label text-muted"></label>
                    <input asp-for="ConfirmNewPassword" class="form-control" />
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <input type="submit" value="Save Changes" class="btn btn-primary" />
                </div>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
