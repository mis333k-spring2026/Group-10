@using Team10FinalProject.Models
@model List<AppUser>

@{
    ViewData["Title"] = "Manage Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color:#333F48;">Manage Customers</h2>
        <p class="text-muted small mb-0">@Model.Count customer(s) registered</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Home</a>
</div>

<div class="card border" style="border-color:#E8D5C4;">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead style="background-color:#F8F0E8;">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>City, State</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td class="align-middle">@customer.FirstName @customer.LastName</td>
                        <td class="align-middle text-muted small">@customer.Email</td>
                        <td class="align-middle text-muted small">
                            @if (!string.IsNullOrEmpty(customer.City))
                            {
                                @customer.City<text>, </text>@customer.State
                            }
                        </td>
                        <td class="align-middle">
                            @if (customer.Status)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disabled</span>
                            }
                        </td>
                        <td class="align-middle text-end">
                            <a asp-action="Edit" asp-route-id="@customer.Id"
                               class="btn btn-sm btn-primary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
