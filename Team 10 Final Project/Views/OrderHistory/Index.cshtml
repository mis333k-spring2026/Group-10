@using System.Collections.Generic
@using Team10FinalProject.Models

@model IEnumerable<Order>
@{
    ViewData["Title"] = "Order History";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Order History</h2>
<hr style="border-color:#E8D5C4;" />

@if (!Model.Any())
{
    <div class="card border p-4 text-center" style="border-color:#E8D5C4; background-color:#F8F0E8;">
        <p class="text-muted mb-3">You have no completed orders.</p>
        <a asp-controller="Song" asp-action="Index" class="btn btn-primary">Browse Songs</a>
    </div>
}
else
{
    @foreach (var order in Model)
    {
        decimal subtotal = order.OrderDetails.Sum(od => od.Price);
        decimal tax = subtotal * 0.0825m;
        decimal total = subtotal + tax;

        <div class="card border mb-4 p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <h5 class="fw-bold mb-3" style="color:#BF5700;">
                Order #@order.OrderNumber —
                <span style="color:#555;">@order.OrderDate.ToString("MMM d, yyyy")</span>
            </h5>

            <table class="table table-striped table-hover align-middle mb-3">
                <thead>
                    <tr style="background-color:#BF5700; color:#fff;">
                        <th>Item</th>
                        <th>Price Paid</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var od in order.OrderDetails)
                    {
                        <tr>
                            <td class="fw-semibold" style="color:#555;">
                                @if (od.Song != null)
                                {
                                    @od.Song.SongName
                                }
                                else if (od.Album != null)
                                {
                                    @od.Album.AlbumName
                                }
                            </td>
                            <td style="color:#BF5700;">@od.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="card border p-3" style="border-color:#E8D5C4; max-width:300px;">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Subtotal</span>
                    <span class="fw-semibold" style="color:#555;">@subtotal.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tax (8.25%)</span>
                    <span class="fw-semibold" style="color:#555;">@tax.ToString("C")</span>
                </div>
                <hr style="border-color:#E8D5C4;" />
                <div class="d-flex justify-content-between">
                    <span class="fw-bold" style="color:#555;">Total</span>
                    <span class="fw-bold" style="color:#BF5700;">@total.ToString("C")</span>
                </div>
            </div>
        </div>
    }
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>