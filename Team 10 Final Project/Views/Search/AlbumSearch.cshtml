@model Team10FinalProject.ViewModels.AlbumSearchViewModel

@{
    ViewData["Title"] = "Album Search";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Album Search</h2>
<hr style="border-color:#E8D5C4;" />

<div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">
    <form asp-action="AlbumSearch" method="post">

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="SearchAlbumName" class="form-label text-muted"></label>
                <input asp-for="SearchAlbumName" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="SearchArtistName" class="form-label text-muted"></label>
                <input asp-for="SearchArtistName" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="SelectedGenreIDs" class="form-label text-muted"></label>
                <div class="border rounded p-2" style="max-height:200px; overflow-y:auto; border-color:#E8D5C4;">
                    @foreach (SelectListItem genre in Model.AllGenres)
                    {
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedGenreIDs"
                                   value="@genre.Value"
                                   @(Model.SelectedGenreIDs.Contains(Int32.Parse(genre.Value)) ? "checked" : null) />
                            <label class="form-check-label" style="color:#555;">@genre.Text</label>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="RatingComparison" class="form-label text-muted"></label>
                <select asp-for="RatingComparison" class="form-select">
                    <option value="">-- Select Comparison --</option>
                    <option value="GreaterThan">Greater Than</option>
                    <option value="LessThan">Less Than</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label asp-for="RatingValue" class="form-label text-muted"></label>
                <input asp-for="RatingValue" class="form-control" min="1" max="5" step="0.1" />
                <span asp-validation-for="RatingValue" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="SortOption" class="form-label text-muted"></label>
                <select asp-for="SortOption" class="form-select">
                    <option value="AlbumNameAsc">Album Name (A-Z)</option>
                    <option value="AlbumNameDesc">Album Name (Z-A)</option>
                    <option value="ArtistNameAsc">Artist Name (A-Z)</option>
                    <option value="ArtistNameDesc">Artist Name (Z-A)</option>
                    <option value="RatingAsc">Rating (Low-High)</option>
                    <option value="RatingDesc">Rating (High-Low)</option>
                </select>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search Albums</button>
            <a asp-action="AlbumSearch" class="btn btn-secondary">Clear</a>
        </div>

    </form>
</div>

<hr style="border-color:#E8D5C4;" />

<p class="text-muted small">Displaying <strong style="color:#333F48;">@Model.SelectedResultsCount</strong> of <strong style="color:#333F48;">@Model.TotalResultsCount</strong> albums</p>

@if (Model.SearchResults != null && Model.SearchResults.Count > 0)
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>Title</th>
                <th>Artist</th>
                <th>Rating</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var album in Model.SearchResults)
            {
                <tr>
                    <td>
                        <a asp-controller="Album"
                           asp-action="Details"
                           asp-route-id="@album.AlbumID"
                           style="color:#BF5700;">
                            @album.AlbumName
                        </a>
                    </td>
                    <td style="color:#555;">@String.Join(", ", album.Artists.Select(a => a.ArtistName))</td>
                    <td style="color:#555;">@album.AvgRating</td>
                    <td style="color:#BF5700;">@album.Price.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No albums found.</p>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}