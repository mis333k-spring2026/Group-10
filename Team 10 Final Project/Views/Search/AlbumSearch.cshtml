@model Team10FinalProject.ViewModels.AlbumSearchViewModel

@{
    ViewData["Title"] = "Album Search";
}

<h1>Album Search</h1>

<form asp-action="AlbumSearch" method="post">
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="SearchAlbumName" class="form-label"></label>
            <input asp-for="SearchAlbumName" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="SearchArtistName" class="form-label"></label>
            <input asp-for="SearchArtistName" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="SelectedGenreIDs" class="form-label"></label>

<div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
    @foreach (SelectListItem genre in Model.AllGenres)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   name="SelectedGenreIDs"
                   value="@genre.Value"
                   @(Model.SelectedGenreIDs.Contains(Int32.Parse(genre.Value)) ? "checked" : null) />

            <label class="form-check-label">@genre.Text</label>
        </div>
    }
</div>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="RatingComparison" class="form-label"></label>
            <select asp-for="RatingComparison" class="form-select">
                <option value="">-- Select Comparison --</option>
                <option value="GreaterThan">Greater Than</option>
                <option value="LessThan">Less Than</option>
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="RatingValue" class="form-label"></label>
            <input asp-for="RatingValue" class="form-control" min="1" max="5" step="0.1" />
            <span asp-validation-for="RatingValue" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="SortOption" class="form-label"></label>
            <select asp-for="SortOption" class="form-select">
                <option value="AlbumNameAsc">Album Name (A-Z)</option>
                <option value="AlbumNameDesc">Album Name (Z-A)</option>
                <option value="ArtistNameAsc">Artist Name (A-Z)</option>
                <option value="ArtistNameDesc">Artist Name (Z-A)</option>
                <option value="RatingAsc">Rating (Low-High)</option>
                <option value="RatingDesc">Rating (High-Low)</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Search Albums</button>
    <a asp-action="AlbumSearch" class="btn btn-secondary">Clear</a>
</form>

<hr />

<p><strong>Displaying @Model.SelectedResultsCount of @Model.TotalResultsCount albums</strong></p>

@if (Model.SearchResults != null && Model.SearchResults.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Artist</th>
                <th>Rating</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var album in Model.SearchResults)
        {
            <tr>
                <td>
                    <a asp-controller="Album" asp-action="Details" asp-route-id="@album.AlbumID">
                        @album.AlbumName
                    </a>
                </td>
                <td>@String.Join(", ", album.Artists.Select(a => a.ArtistName))</td>
                <td>@album.AvgRating</td>
                <td>@album.Price.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No albums found.</p>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}