@model Team10FinalProject.ViewModels.ArtistSearchViewModel

@{
    ViewData["Title"] = "Artist Search";
}

<h1>Artist Search</h1>

<form asp-action="ArtistSearch" method="post">
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="SearchArtistName" class="form-label"></label>
            <input asp-for="SearchArtistName" class="form-control" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="SelectedGenreIDs" class="form-label"></label>

<div class="border rounded p-2" style="max-height: 200px; overflow-y: auto;">
    @foreach (SelectListItem genre in Model.AllGenres)
    {
        <div class="form-check">
            <input class="form-check-input"
                   type="checkbox"
                   name="SelectedGenreIDs"
                   value="@genre.Value"
                   @(Model.SelectedGenreIDs.Contains(Int32.Parse(genre.Value)) ? "checked" : null) />

            <label class="form-check-label">@genre.Text</label>
        </div>
    }
</div>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="RatingComparison" class="form-label"></label>
            <select asp-for="RatingComparison" class="form-select">
                <option value="">-- Select Comparison --</option>
                <option value="GreaterThan">Greater Than</option>
                <option value="LessThan">Less Than</option>
            </select>
        </div>

        <div class="col-md-2 mb-3">
            <label asp-for="RatingValue" class="form-label"></label>
            <input asp-for="RatingValue" class="form-control" min="1" max="5" step="0.1" />
            <span asp-validation-for="RatingValue" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="SortOption" class="form-label"></label>
            <select asp-for="SortOption" class="form-select">
                <option value="ArtistNameAsc">Artist Name (A-Z)</option>
                <option value="ArtistNameDesc">Artist Name (Z-A)</option>
                <option value="RatingAsc">Rating (Low-High)</option>
                <option value="RatingDesc">Rating (High-Low)</option>
            </select>
        </div>
    </div>

    <button type="submit" class="btn btn-info">Search Artists</button>
    <a asp-action="ArtistSearch" class="btn btn-secondary">Clear</a>
</form>

<hr />

<p><strong>Displaying @Model.SelectedResultsCount of @Model.TotalResultsCount artists</strong></p>

@if (Model.SearchResults != null && Model.SearchResults.Count > 0)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Name</th>
                <th>Rating</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var artist in Model.SearchResults)
        {
            <tr>
                <td>
                    <a asp-controller="Artist" asp-action="Details" asp-route-id="@artist.ArtistID">
                        @artist.ArtistName
                    </a>
                </td>
                <td>@artist.AvgRating</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No artists found.</p>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}