@{
    ViewData["Title"] = "Music Search";
}

<h1>Music Search</h1>

<p>Select a search type below.</p>

<div class="mb-3">
    <a asp-action="SongSearch" class="btn btn-primary me-2">Search Songs</a>
    <a asp-action="AlbumSearch" class="btn btn-success me-2">Search Albums</a>
    <a asp-action="ArtistSearch" class="btn btn-info">Search Artists</a>
</div>