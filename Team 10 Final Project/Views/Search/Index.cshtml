@{
    ViewData["Title"] = "Music Search";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Music Search</h2>
<hr style="border-color:#E8D5C4;" />

<p class="text-muted mb-4">Select a search type below.</p>

<div class="row g-3">
    <div class="col-md-4">
        <a asp-action="SongSearch" class="card text-decoration-none h-100 p-3 text-center border" style="border-color:#E8D5C4;">
            <h5 style="color:#BF5700;">Songs</h5>
            <p class="text-muted small mb-0">Search the song catalog</p>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="AlbumSearch" class="card text-decoration-none h-100 p-3 text-center border" style="border-color:#E8D5C4;">
            <h5 style="color:#BF5700;">Albums</h5>
            <p class="text-muted small mb-0">Search all albums</p>
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="ArtistSearch" class="card text-decoration-none h-100 p-3 text-center border" style="border-color:#E8D5C4;">
            <h5 style="color:#BF5700;">Artists</h5>
            <p class="text-muted small mb-0">Search all artists</p>
        </a>
    </div>
</div>