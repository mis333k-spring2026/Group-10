@model IEnumerable<Song>
@{
    ViewData["Title"] = "Search";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Search Songs</h2>
<hr style="border-color:#E8D5C4;" />

<form asp-action="Index" method="get">
    <div class="row g-2 align-items-end mb-3">
        <div class="col-md-8">
            <label for="searchString" class="form-label fw-semibold" style="color:#333F48;">Search by Title</label>
            <input type="text" name="searchString" class="form-control"
                   value="@Context.Request.Query["searchString"]"
                   placeholder="Enter song title..." />
        </div>
        <div class="col-md-2">
            <input type="submit" value="Search" class="btn btn-primary w-100" />
        </div>
    </div>
</form>

@if (Model != null)
{
    <p class="text-muted small">Displaying @Model.Count() result(s)</p>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>Song Name</th>
                <th>Artist</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold" style="color:#333F48;">@item.SongName</td>
                    <td style="color:#9D4700;">@item.Artist.ArtistName</td>
                    <td style="color:#BF5700;">$@item.Price</td>
                    <td>
                        <a asp-controller="Song" asp-action="Details" asp-route-id="@item.SongID"
                           class="btn btn-sm btn-outline-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Back to Home</a>