@model Order

@{
    ViewData["Title"] = "Checkout";
    decimal subtotal = Model.OrderDetails != null ? Model.OrderDetails.Sum(od => od.Price) : 0m;
    decimal tax = subtotal * 0.0825m;
    decimal total = subtotal + tax;

    List<Card> cards = ViewBag.Cards == null
        ? new List<Card>()
        : (List<Card>)ViewBag.Cards;
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Checkout</h2>
<hr style="border-color:#E8D5C4;" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-4">

    <div class="col-md-8">
        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <h5 class="fw-bold mb-3" style="color:#BF5700;">Order Summary</h5>

            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr style="background-color:#BF5700; color:#fff;">
                        <th>Item</th>
                        <th>Artist</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var od in Model.OrderDetails)
                    {
                        <tr>
                            <td class="fw-semibold" style="color:#555;">
                                @if (od.Song != null)
                                {
                                    @od.Song.SongName
                                }
                                else if (od.Album != null)
                                {
                                    @od.Album.AlbumName
                                }
                            </td>
                            <td style="color:#9D4700;">
                                @if (od.Song != null)
                                {
                                    @od.Song.Artist?.ArtistName
                                }
                                else if (od.Album != null)
                                {
                                    @String.Join(", ", od.Album.Artists.Select(a => a.ArtistName))
                                }
                            </td>
                            <td style="color:#BF5700;">@od.Price.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="card border p-3 mt-2" style="border-color:#E8D5C4; max-width:300px;">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Subtotal</span>
                    <span class="fw-semibold" style="color:#555;">@subtotal.ToString("C")</span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tax (8.25%)</span>
                    <span class="fw-semibold" style="color:#555;">@tax.ToString("C")</span>
                </div>
                <hr style="border-color:#E8D5C4;" />
                <div class="d-flex justify-content-between">
                    <span class="fw-bold" style="color:#555;">Total</span>
                    <span class="fw-bold" style="color:#BF5700;">@total.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <h5 class="fw-bold mb-3" style="color:#BF5700;">Payment</h5>

            @if (!cards.Any())
            {
                <p class="text-danger small">You need to save a card before checking out.</p>
                <a asp-controller="Card" asp-action="Create" class="btn btn-primary">Add Card</a>
            }
            else
            {
                <form asp-action="Checkout" method="post">
                    <div class="mb-4">
                        <label for="cardID" class="form-label text-muted">Select Payment Card</label>
                        <select id="cardID" name="cardID" class="form-select" required>
                            <option value="">-- Select a card --</option>
                            @foreach (var card in cards)
                            {
                                <option value="@card.CardID">@card.MaskedCardNumber</option>
                            }
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Place Order</button>
                        <a asp-action="Index" class="btn btn-secondary">Back to Cart</a>
                    </div>
                </form>
            }
        </div>
    </div>

</div>