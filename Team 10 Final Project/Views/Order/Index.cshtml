@model Order

@{
    ViewData["Title"] = "Shopping Cart";
    decimal subtotal = Model.OrderDetails != null ? Model.OrderDetails.Sum(od => od.Price) : 0m;
    decimal tax = subtotal * 0.0825m;
    decimal total = subtotal + tax;
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Shopping Cart</h2>
<hr style="border-color:#E8D5C4;" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.OrderDetails == null || !Model.OrderDetails.Any())
{
    <div class="card p-4 text-center border" style="border-color:#E8D5C4;">
        <p class="text-muted mb-3">Your cart is empty.</p>
        <a asp-controller="Song" asp-action="Index" class="btn btn-primary">Browse Songs</a>
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>Item</th>
                <th>Artist</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var od in Model.OrderDetails)
            {
                <tr>
                    <td class="fw-semibold" style="color:#333F48;">
                        @if (od.Song != null)
                        {
                            @od.Song.SongName
                        }
                        else if (od.Album != null)
                        {
                            @od.Album.AlbumName
                        }
                    </td>
                    <td style="color:#9D4700;">
                        @if (od.Song != null)
                        {
                            @od.Song.Artist?.ArtistName
                        }
                        else if (od.Album != null)
                        {
                            @String.Join(", ", od.Album.Artists.Select(a => a.ArtistName))
                        }
                    </td>
                    <td style="color:#BF5700;">@od.Price.ToString("C")</td>
                    <td>
                        @if (od.Song != null)
                        {
                            <a asp-action="RemoveSong" asp-route-songID="@od.Song.SongID"
                               class="btn btn-sm btn-outline-danger">Remove</a>
                        }
                        else if (od.Album != null)
                        {
                            <a asp-action="RemoveAlbum" asp-route-albumID="@od.Album.AlbumID"
                               class="btn btn-sm btn-outline-danger">Remove</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card p-3 mb-4 border" style="border-color:#E8D5C4; max-width:300px;">
        <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Subtotal</span>
            <span class="fw-semibold" style="color:#333F48;">@subtotal.ToString("C")</span>
        </div>
        <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Tax (8.25%)</span>
            <span class="fw-semibold" style="color:#333F48;">@tax.ToString("C")</span>
        </div>
        <hr style="border-color:#E8D5C4;" />
        <div class="d-flex justify-content-between">
            <span class="fw-bold" style="color:#333F48;">Total</span>
            <span class="fw-bold" style="color:#BF5700;">@total.ToString("C")</span>
        </div>
    </div>

    <a asp-action="Checkout" class="btn btn-primary">Proceed to Checkout</a>
}

<div class="d-flex gap-3 mt-4">
    <a asp-controller="Song" asp-action="Index" class="btn btn-outline-primary btn-sm">Browse Songs</a>
    <a asp-controller="Album" asp-action="Index" class="btn btn-outline-primary btn-sm">Browse Albums</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm">Home</a>
</div>