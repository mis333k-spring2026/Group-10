@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="mt-4">
    <div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">
        <h4 class="fw-bold mb-2" style="color:#BF5700;">Order Placed Successfully!</h4>
        <p style="color:#555;">Thank you for your purchase. Your order has been confirmed and a confirmation email has been sent to your email address.</p>
        <hr style="border-color:#E8D5C4;" />
        <p class="mb-0" style="color:#555;">
            You can view your order history and access your purchases from your
            <a asp-controller="MyMusic" asp-action="Index" style="color:#BF5700;">My Music</a> page.
        </p>
    </div>

    <div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">
        <h5 class="fw-bold mb-3" style="color:#333F48;">What's Next?</h5>
        <ul style="color:#555;">
            <li class="mb-1">Check your email for the order confirmation</li>
            <li class="mb-1">Your purchased music is now available in your library</li>
            <li class="mb-1">
                Visit <a asp-controller="MyMusic" asp-action="Index" style="color:#BF5700;">My Music</a> to access your collection
            </li>
        </ul>
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to Home</a>
        <a asp-controller="Song" asp-action="Index" class="btn btn-secondary">Shop More Music</a>
        <a asp-controller="MyMusic" asp-action="Index" class="btn btn-outline-primary">View My Music</a>
    </div>
</div>