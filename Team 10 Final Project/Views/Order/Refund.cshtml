@model Team10FinalProject.Models.Order

@{
    ViewData["Title"] = "Refund Order";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">

        <div class="card border p-4" style="border-color:#E8C4C4; background-color:#fff;">
            <h2 class="fw-bold mb-1" style="color:#333F48;">Cancel Order</h2>
            <p class="text-muted mb-4">Review the order below. If this was made in error, click <strong>Confirm Refund</strong> to cancel it and remove the music from your account.</p>

            <div class="mb-3">
                <p class="mb-1 text-muted small">Order Number</p>
                <p class="fw-semibold mb-0">#@Model.OrderNumber</p>
            </div>
            <div class="mb-4">
                <p class="mb-1 text-muted small">Order Date</p>
                <p class="fw-semibold mb-0">@Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>

            <h5 class="fw-semibold mb-2" style="color:#333F48;">Items to be Removed</h5>
            <ul class="list-group list-group-flush mb-4">
                @foreach (var item in Model.OrderDetails)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>
                            @if (item.Song != null)
                            {
                                <span class="badge bg-secondary me-1">Song</span>@item.Song.SongName
                            }
                            else if (item.Album != null)
                            {
                                <span class="badge me-1" style="background-color:#BF5700;">Album</span>@item.Album.AlbumName
                            }
                        </span>
                        <span class="text-muted">@item.Price.ToString("C")</span>
                    </li>
                }
            </ul>

            <div class="alert alert-warning mb-4">
                <strong>Warning:</strong> This action cannot be undone. The music will be removed from your library and a refund confirmation will be sent to your email.
            </div>

            <form asp-action="ConfirmRefund" asp-route-id="@Model.OrderID" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Confirm Refund</button>
                    <a asp-controller="OrderHistory" asp-action="Index" class="btn btn-outline-secondary">Cancel — Keep Order</a>
                </div>
            </form>
        </div>

    </div>
</div>
