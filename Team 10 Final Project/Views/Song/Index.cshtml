@model IEnumerable<Song>
@{
    ViewData["Title"] = "Songs";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Songs</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>@Html.DisplayNameFor(model => model.SongName)</th>
            <th>Band</th>
            <th>Album</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.AvgRating)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:#555;">@Html.DisplayFor(modelItem => item.SongName)</td>
                <td style="color:#9D4700;">@Html.DisplayFor(modelItem => item.Artist.ArtistName)</td>
                <td style="color:#555;">
                    @if (item.Albums != null && item.Albums.Any())
                    {
                        @string.Join(", ", item.Albums.Select(a => a.AlbumName))
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td style="color:#BF5700;">@Html.DisplayFor(modelItem => item.Price)</td>
                <td style="color:#555;">@Html.DisplayFor(modelItem => item.AvgRating)</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.SongID"
                       class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>