@model IEnumerable<Song>
@{
    ViewData["Title"] = "Songs";
}
<h1>Songs</h1>
<p><strong>Total Records:</strong> @Model.Count()</p>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.SongName)</th>
            <th>Artist</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.AvgRating)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.SongName)</td>
                <td>@Html.DisplayFor(modelItem => item.Artist.ArtistName)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.AvgRating)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.SongID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
