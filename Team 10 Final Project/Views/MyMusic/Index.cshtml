@model IEnumerable<Song>
@{
    ViewData["Title"] = "My Music";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">My Music</h2>
<hr style="border-color:#E8D5C4;" />

@if (!Model.Any())
{
    <div class="card border p-4 text-center" style="border-color:#E8D5C4; background-color:#F8F0E8;">
        <p class="text-muted mb-3">You do not own any music yet.</p>
        <a asp-controller="Song" asp-action="Index" class="btn btn-primary">Browse Songs</a>
    </div>
}
else
{
    <p class="text-muted small">@Model.Count() song(s) in your collection</p>

    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr style="background-color:#BF5700; color:#fff;">
                <th>Song Name</th>
                <th>Artist</th>
                <th>Genres</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold" style="color:#555;">@item.SongName</td>
                    <td style="color:#9D4700;">@item.Artist.ArtistName</td>
                    <td>
                        @foreach (var genre in item.Genres)
                        {
                            <span class="badge me-1" style="background-color:#E8D5C4; color:#555;">@genre.GenreName</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Song"
                           asp-action="Details"
                           asp-route-id="@item.SongID"
                           class="btn btn-sm btn-outline-primary">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>