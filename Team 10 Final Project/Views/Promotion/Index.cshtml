@model IEnumerable<Team10FinalProject.Models.Promotion>

@{
    ViewData["Title"] = "Promotions";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Promotions</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>Promotion ID</th>
            <th>@Html.DisplayNameFor(model => model.PromotionType)</th>
            <th>@Html.DisplayNameFor(model => model.DiscountAmount)</th>
            <th>Status</th>
            <th>Applies To</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="color:#555;">@item.PromotionID</td>
                <td class="fw-semibold" style="color:#555;">@item.PromotionType</td>
                <td style="color:#BF5700;">@item.DiscountAmount</td>
                <td>
                    @if (item.PromotionStatus.ToString() == "Active")
                    {
                        <span class="badge" style="background-color:#BF5700;">Active</span>
                    }
                    else
                    {
                        <span class="badge" style="background-color:#E8D5C4; color:#555;">Inactive</span>
                    }
                </td>
                <td style="color:#555;">
                    @if (item.Song != null)
                    {
                        @:Song: @item.Song.SongName
                    }
                    else if (item.Album != null)
                    {
                        @:Album: @item.Album.AlbumName
                    }
                    else if (item.Artist != null)
                    {
                        @:Artist: @item.Artist.ArtistName
                    }
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.PromotionID"
                       class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>