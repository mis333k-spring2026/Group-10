@model Team10FinalProject.Models.Promotion

@{
    ViewData["Title"] = "Promotion Details";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Promotion Details</h2>
<hr style="border-color:#E8D5C4;" />

<div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">

    <dl class="row">
        <dt class="col-sm-3 text-muted">Promotion ID</dt>
        <dd class="col-sm-9 fw-semibold" style="color:#555;">@Model.PromotionID</dd>

        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.PromotionType)</dt>
        <dd class="col-sm-9 fw-semibold" style="color:#555;">@Model.PromotionType</dd>

        <dt class="col-sm-3 text-muted">@Html.DisplayNameFor(model => model.DiscountAmount)</dt>
        <dd class="col-sm-9 fw-semibold" style="color:#BF5700;">@Model.DiscountAmount</dd>

        <dt class="col-sm-3 text-muted">Status</dt>
        <dd class="col-sm-9">
            @if (Model.PromotionStatus.ToString() == "Active")
            {
                <span class="badge" style="background-color:#BF5700;">Active</span>
            }
            else
            {
                <span class="badge" style="background-color:#E8D5C4; color:#555;">Inactive</span>
            }
        </dd>

        <dt class="col-sm-3 text-muted">Song</dt>
        <dd class="col-sm-9" style="color:#555;">@Model.Song?.SongName</dd>

        <dt class="col-sm-3 text-muted">Album</dt>
        <dd class="col-sm-9" style="color:#555;">@Model.Album?.AlbumName</dd>

        <dt class="col-sm-3 text-muted">Artist</dt>
        <dd class="col-sm-9" style="color:#555;">@Model.Artist?.ArtistName</dd>
    </dl>
</div>

<a asp-action="Index" style="color:#BF5700;">Back to List</a>