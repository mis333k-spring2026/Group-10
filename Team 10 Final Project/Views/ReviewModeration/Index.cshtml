@model IEnumerable<Team10FinalProject.Models.Review>

@{
    ViewData["Title"] = "Review Moderation";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0" style="color:#333F48;">Review Moderation</h2>
        <p class="text-muted small mb-0">Approve reviews or edit their text for clarity. Ratings cannot be changed.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Home</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">There are no reviews yet.</div>
}
else
{
    <div class="card border" style="border-color:#E8D5C4;">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead style="background-color:#F8F0E8;">
                    <tr>
                        <th>Reviewer</th>
                        <th>Rating</th>
                        <th>Review Text</th>
                        <th>Item</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var review in Model)
                    {
                        <tr>
                            <td class="align-middle small text-muted">
                                @(review.Reviewer != null ? review.Reviewer.Email : "Unknown")
                            </td>
                            <td class="align-middle">
                                <span class="badge bg-secondary">@review.Rating / 5</span>
                            </td>
                            <td class="align-middle">
                                @if (string.IsNullOrWhiteSpace(review.ReviewText))
                                {
                                    <span class="text-muted fst-italic">No text</span>
                                }
                                else
                                {
                                    @review.ReviewText
                                }
                            </td>
                            <td class="align-middle small text-muted">
                                @if (review.Song != null) { <span>Song: @review.Song.SongName</span> }
                                else if (review.Album != null) { <span>Album: @review.Album.AlbumName</span> }
                                else if (review.Artist != null) { <span>Artist: @review.Artist.ArtistName</span> }
                            </td>
                            <td class="align-middle text-end">
                                <a asp-action="Approve" asp-route-id="@review.ReviewID"
                                   class="btn btn-sm btn-success">Approve</a>
                                <a asp-action="Edit" asp-route-id="@review.ReviewID"
                                   class="btn btn-sm btn-primary ms-1">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
