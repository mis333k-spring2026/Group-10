@using Microsoft.AspNetCore.Identity
@using Team10FinalProject.Models
@model object

@{
    ViewData["Title"] = "Error";

    List<string> messages = new List<string>();

    if (Model is ErrorViewModel evm)
    {
        if (!string.IsNullOrWhiteSpace(evm.RequestId))
        {
            messages.Add($"Request ID: {evm.RequestId}");
        }
    }
    else if (Model is IEnumerable<string> stringList)
    {
        messages.AddRange(stringList.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
    else if (Model is IEnumerable<IdentityError> identityErrors)
    {
        messages.AddRange(identityErrors.Select(e => e.Description));
    }
    else if (Model != null)
    {
        messages.Add(Model.ToString() ?? "An unknown error occurred.");
    }

    if (messages.Count == 0)
    {
        messages.Add("An error occurred while processing your request.");
    }
}

<h1 class="text-danger">Error</h1>
<h2 class="text-danger">Something went wrong.</h2>

<ul>
    @foreach (string message in messages)
    {
        <li>@message</li>
    }
</ul>

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return Home</a>
</div>