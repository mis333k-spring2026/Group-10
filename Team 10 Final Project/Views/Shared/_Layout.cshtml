<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Team10FinalProject</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- UT Austin colors -->
    <style>
      :root {
        --ut-orange:      #BF5700;
        --ut-orange-dark: #9D4700;
        --ut-charcoal:    #333F48;
        --ut-cream:       #F8F0E8;
        --ut-tan:         #E8D5C4;
      }

      body { background-color: var(--ut-cream); color: var(--ut-charcoal); }

      h1, h2, h3, h4, h5, h6 { color: var(--ut-charcoal); }

      a { color: var(--ut-orange); }
      a:hover { color: var(--ut-orange-dark); }

      .btn-primary { background-color: var(--ut-orange); border-color: var(--ut-orange); color: #fff; }
      .btn-primary:hover { background-color: var(--ut-orange-dark); border-color: var(--ut-orange-dark); color: #fff; }
      .btn-outline-primary { color: var(--ut-orange); border-color: var(--ut-orange); }
      .btn-outline-primary:hover { background-color: var(--ut-orange); color: #fff; }

      .card { background-color: #fff; border-color: var(--ut-tan); }
      .card-header { background-color: var(--ut-tan); color: var(--ut-charcoal); }

      .table thead { background-color: var(--ut-orange); color: #fff; }
      .table-striped tbody tr:nth-of-type(odd) { background-color: var(--ut-cream); }

      .form-control:focus { border-color: var(--ut-orange); box-shadow: 0 0 0 0.2rem rgba(191, 87, 0, 0.25); }
      label { color: var(--ut-charcoal); }

      .footer { background-color: var(--ut-charcoal); color: #fff; }
      .footer a { color: var(--ut-tan); }
      .footer a:hover { color: #fff; }
    </style>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Team10FinalProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-3" style="background-color: var(--ut-orange);">
            <div class="container-fluid">
                <a class="navbar-brand text-white" asp-area="" asp-controller="Home" asp-action="Index">Team10FinalProject</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="MyMusic" asp-action="Index">My Songs</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Order" asp-action="Checkout">Cart</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="OrderHistory" asp-action="Index">Order History</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="btn btn-light text-dark" asp-area="" asp-controller="Account" asp-action="Index">Account</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Team10FinalProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>