@model Team10FinalProject.ViewModels.IndexViewModel
@{
    ViewBag.Title = "Edit Account Information";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Edit Account Information</h2>
<hr style="border-color:#E8D5C4;" />

<div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">
    <h5 class="fw-semibold mb-3" style="color:#BF5700;">Edit Your Account Settings</h5>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-muted">First Name</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Employee"))
                {
                    <p class="form-control-plaintext">@Model.FirstName</p>
                }
                else
                {
                    <input type="text" id="FirstName" name="FirstName" class="form-control" value="@Model.FirstName" />
                }
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-muted">Last Name</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Employee"))
                {
                    <p class="form-control-plaintext">@Model.LastName</p>
                }
                else
                {
                    <input type="text" id="LastName" name="LastName" class="form-control" value="@Model.LastName" />
                }
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-muted">Email</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Employee"))
                {
                    <p class="form-control-plaintext">@Model.Email</p>
                }
                else
                {
                    <input type="email" id="Email" name="Email" class="form-control" value="@Model.Email" />
                }
            </div>
        </div>

        <div class="row mb-3">
            <label for="PhoneNumber" class="col-sm-3 col-form-label text-muted">Phone Number</label>
            <div class="col-sm-9">
                <input type="text" id="PhoneNumber" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
            </div>
        </div>

        <div class="row mb-3">
            <label for="Address" class="col-sm-3 col-form-label text-muted">Address</label>
            <div class="col-sm-9">
                <input type="text" id="Address" name="Address" class="form-control" value="@Model.Address" />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-muted">City</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Employee"))
                {
                    <p class="form-control-plaintext" id="CityDisplay">@Model.City</p>
                }
                else
                {
                    <input type="text" id="City" name="City" class="form-control" value="@Model.City" />
                }
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-sm-3 col-form-label text-muted">State</label>
            <div class="col-sm-9">
                @if (User.IsInRole("Employee"))
                {
                    <p class="form-control-plaintext" id="StateDisplay">@Model.State</p>
                }
                else
                {
                    <input type="text" id="State" name="State" class="form-control" value="@Model.State" />
                }
            </div>
        </div>

        <div class="row mb-4">
            <label for="ZipCode" class="col-sm-3 col-form-label text-muted">Zip Code</label>
            <div class="col-sm-9">
                <input type="text" id="ZipCode" name="ZipCode" class="form-control" value="@Model.ZipCode"
                       @(User.IsInRole("Employee") ? "oninput=\"updateCityState(this.value)\"" : "") />
            </div>
        </div>

        <div class="d-flex gap-2">
            <input type="submit" value="Save Changes" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<a asp-action="Index" style="color:#BF5700;">Back to Account Information</a>

@if (User.IsInRole("Employee"))
{
    @section Scripts {
        <script>
            function updateCityState(zip) {
                if (!/^\d{5}$/.test(zip)) return;
                fetch('https://api.zippopotam.us/us/' + zip)
                    .then(function(r) { return r.ok ? r.json() : null; })
                    .then(function(data) {
                        if (!data) return;
                        document.getElementById('CityDisplay').textContent = data.places[0]['place name'];
                        document.getElementById('StateDisplay').textContent = data.places[0]['state abbreviation'];
                    })
                    .catch(function() {});
            }
        </script>
    }
}