@{
    ViewData["Title"] = "User Added";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">

        <div class="card border p-5" style="border-color:#E8D5C4; background-color:#fff;">
            <div class="mb-3" style="font-size:3rem; color:#BF5700;">&#10003;</div>
            <h2 class="fw-bold mb-2" style="color:#333F48;">User Added Successfully</h2>
            <p class="text-muted mb-4">The new account has been created and a confirmation email has been sent.</p>

            <div class="d-grid gap-2">
                <a asp-controller="Account" asp-action="AddUser" class="btn btn-primary">Add Another User</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
            </div>
        </div>

    </div>
</div>
