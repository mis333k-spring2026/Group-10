@using Team10FinalProject.ViewModels
@model RegisterViewModel

@{
    ViewData["Title"] = "Add User";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">

        <div class="card border p-4" style="border-color:#E8D5C4; background-color:#fff;">
            <h2 class="fw-bold mb-1 text-center" style="color:#333F48;">Add New User</h2>
            <p class="text-muted text-center mb-4">Create a new account and assign a role</p>

            <form asp-action="AddUser" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row mb-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label text-muted"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label text-muted"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label text-muted"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ZipCode" class="form-label text-muted"></label>
                    <input asp-for="ZipCode" class="form-control" />
                    <span asp-validation-for="ZipCode" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-muted"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label text-muted"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label text-muted"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label text-muted"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label for="roleName" class="form-label text-muted">Role</label>
                    <select name="roleName" id="roleName" class="form-select" required>
                        <option value="">-- Select a Role --</option>
                        @foreach (var role in ViewBag.AllRoles as List<string>)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>

                <div class="d-grid">
                    <input type="submit" value="Create Account" class="btn btn-primary" />
                </div>
            </form>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="Index" style="color:#BF5700;" class="small">Back to Home</a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
