@model Artist

@{
    ViewData["Title"] = "Artist Details";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Artist Details</h2>
<hr style="border-color:#E8D5C4;" />

<div class="card border p-4 mb-4" style="border-color:#E8D5C4; background-color:#fff;">

    <dl class="row">
        <dt class="col-sm-2 text-muted">Artist</dt>
        <dd class="col-sm-10 fw-semibold" style="color:#333F48;">@Model.ArtistName</dd>

        <dt class="col-sm-2 text-muted">Genres</dt>
        <dd class="col-sm-10">
            @if (Model.Genres != null && Model.Genres.Any())
            {
                @foreach (var genre in Model.Genres)
                {
                    <span class="badge me-1" style="background-color:#E8D5C4; color:#333F48;">@genre.GenreName</span>
                }
            }
            else
            {
                <span class="text-muted">No genres listed.</span>
            }
        </dd>

        <dt class="col-sm-2 text-muted">Albums</dt>
        <dd class="col-sm-10">
            @if (Model.Albums != null && Model.Albums.Any())
            {
                @foreach (var album in Model.Albums)
                {
                    <div>
                        <a asp-controller="Album"
                           asp-action="Details"
                           asp-route-id="@album.AlbumID"
                           style="color:#BF5700;">
                            @album.AlbumName
                        </a>
                    </div>
                }
            }
            else
            {
                <span class="text-muted">No albums listed.</span>
            }
        </dd>

        <dt class="col-sm-2 text-muted">Songs</dt>
        <dd class="col-sm-10">
            @if (Model.Songs != null && Model.Songs.Any())
            {
                @foreach (var song in Model.Songs)
                {
                    <div>
                        <a asp-controller="Song"
                           asp-action="Details"
                           asp-route-id="@song.SongID"
                           style="color:#BF5700;">
                            @song.SongName
                        </a>
                    </div>
                }
            }
            else
            {
                <span class="text-muted">No songs listed.</span>
            }
        </dd>
    </dl>
</div>

<div class="d-flex gap-3 mt-2">
    <a asp-action="Index" style="color:#BF5700;">Back to Artists</a>
    <a asp-controller="Home" asp-action="Index" style="color:#BF5700;">Home</a>
</div>