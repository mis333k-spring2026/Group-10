@model Artist
@{
    ViewData["Title"] = "Artist Details";
}
<h1>Artist Details</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ArtistName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.ArtistName)</dd>

        <dt class="col-sm-2">Songs</dt>
        <dd class="col-sm-10">
            @foreach (var song in Model.Songs)
            {
                <a asp-controller="Song" asp-action="Details" asp-route-id="@song.SongID">@song.SongName</a>
                <span> </span>
            }
        </dd>

        @* TODO: Add Albums once ArtistController.Details includes Albums *@
    </dl>
</div>
<br />
<div>
    <a asp-action="Index">Back to Artists</a> |
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
