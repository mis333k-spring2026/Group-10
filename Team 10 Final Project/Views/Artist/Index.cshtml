@model IEnumerable<Artist>
@{
    ViewData["Title"] = "Artists";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Artists</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>@Html.DisplayNameFor(model => model.ArtistName)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:#333F48;">@Html.DisplayFor(modelItem => item.ArtistName)</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.ArtistID"
                       class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>