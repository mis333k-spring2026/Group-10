@model Team10FinalProject.Models.Album

@{
    ViewData["Title"] = "Edit Album";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Edit Album</h2>
<p class="text-muted mb-4">Automatically generated fields (ID, Rating) cannot be edited.</p>
<hr style="border-color:#E8D5C4;" />

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="AlbumID" />
    <input type="hidden" asp-for="AvgRating" />

    <div class="mb-3">
        <label asp-for="AlbumName" class="form-label fw-semibold"></label>
        <input asp-for="AlbumName" class="form-control" />
        <span asp-validation-for="AlbumName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AlbumCover" class="form-label fw-semibold">Album Cover URL</label>
        <input asp-for="AlbumCover" class="form-control" />
        <span asp-validation-for="AlbumCover" class="text-danger"></span>

        @* Show current / preview *@
        <div class="mt-2">
            <img id="previewImg"
                 src="@Model.AlbumCover"
                 alt="Cover preview"
                 class="rounded shadow-sm"
                 style="max-height:160px; object-fit:cover; border:2px solid #E8D5C4;
                        display:@(string.IsNullOrEmpty(Model.AlbumCover) ? "none" : "block");" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label fw-semibold"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label fw-semibold">Active</label>
        <input asp-for="Status" type="checkbox" class="form-check-input ms-2" />
    </div>

    @* Artist selection with song filtering *@
    <div class="mb-3">
        <label class="form-label fw-semibold">Artist(s)</label>
        <select id="artistSelect"
                name="selectedArtists"
                asp-items="ViewBag.AllArtists"
                class="form-select"
                multiple>
        </select>
        <div class="form-text">Hold Ctrl (or Cmd) to select multiple artists.</div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Songs</label>
        <select id="songSelect"
                name="selectedSongs"
                class="form-select"
                multiple
                style="min-height:140px;">
            @* Pre-populated by JS on load *@
        </select>
        <div class="form-text">Hold Ctrl (or Cmd) to select multiple songs.</div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Details" asp-route-id="@Model.AlbumID" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
<script>
    const allSongs         = @Html.Raw(ViewBag.SongsJson ?? "[]");
    const currentSongIds   = @Html.Raw(ViewBag.CurrentSongIds ?? "[]");
    const currentArtistIds = @Html.Raw(ViewBag.CurrentArtistIds ?? "[]");

    const artistSelect = document.getElementById('artistSelect');
    const songSelect   = document.getElementById('songSelect');

    // Pre-select the album's existing artists
    Array.from(artistSelect.options).forEach(opt => {
        if (currentArtistIds.includes(parseInt(opt.value))) {
            opt.selected = true;
        }
    });

    function filterSongs(preserveSelection) {
        const selectedArtistIds = Array.from(artistSelect.selectedOptions)
            .map(opt => parseInt(opt.value));

        songSelect.innerHTML = '';

        if (selectedArtistIds.length === 0) return;

        const filtered = allSongs.filter(s => selectedArtistIds.includes(s.artistID));

        if (filtered.length === 0) {
            const opt = document.createElement('option');
            opt.disabled = true;
            opt.textContent = 'No songs found for selected artist(s)';
            songSelect.appendChild(opt);
            return;
        }

        filtered.forEach(song => {
            const opt = document.createElement('option');
            opt.value  = song.songID;
            opt.textContent = song.songName;
            // Re-select songs that were already on this album
            if (preserveSelection && currentSongIds.includes(song.songID)) {
                opt.selected = true;
            }
            songSelect.appendChild(opt);
        });
    }

    // Load songs on page init with existing selections preserved
    filterSongs(true);
    artistSelect.addEventListener('change', () => filterSongs(false));

    // Cover preview on URL change
    const coverInput = document.getElementById('AlbumCover');
    const previewImg = document.getElementById('previewImg');

    coverInput.addEventListener('input', function () {
        const url = this.value.trim();
        if (url.length > 10) {
            previewImg.src = url;
            previewImg.style.display = 'block';
        } else {
            previewImg.style.display = 'none';
        }
    });
</script>
}
