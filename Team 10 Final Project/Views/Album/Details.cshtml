@model Album
@{
    ViewData["Title"] = "Album Details";
}
<h1>Album Details</h1>
<hr />
<div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.AlbumName)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.AlbumName)</dd>

        <dt class="col-sm-2">Artist</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Artist.ArtistName)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>

        <dt class="col-sm-2">Songs</dt>
        <dd class="col-sm-10">
            @foreach (var song in Model.Songs)
            {
                <a asp-controller="Song" asp-action="Details" asp-route-id="@song.SongID">@song.SongName</a>
                <span> </span>
            }
        </dd>
    </dl>
</div>

@if (User.Identity.IsAuthenticated)
{
    <div>
        <a class="btn btn-primary">Add to Cart</a>
        @* TODO: wire up once AddAlbum action exists in OrderController *@
    </div>
}

<br />
<div>
    <a asp-action="Index">Back to Albums</a> |
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
