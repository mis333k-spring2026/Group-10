@model IEnumerable<Album>
@{
    ViewData["Title"] = "Albums";
}
<h1>Albums</h1>
<hr />
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.AlbumName)</th>
            <th>Artist</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.AlbumName)</td>
                <td>@Html.DisplayFor(modelItem => item.Artist.ArtistName)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.AlbumID">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div>
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
