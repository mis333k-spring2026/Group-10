@model IEnumerable<Album>
@{
    ViewData["Title"] = "Albums";
}

<h2 class="fw-bold mb-1" style="color:#333F48;">Albums</h2>
<p class="text-muted small">Total Records: @Model.Count()</p>
<hr style="border-color:#E8D5C4;" />

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr style="background-color:#BF5700; color:#fff;">
            <th>@Html.DisplayNameFor(model => model.AlbumName)</th>
            <th>Artist</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-semibold" style="color:#333F48;">@Html.DisplayFor(modelItem => item.AlbumName)</td>
                <td>
                    @if (item.Artists != null && item.Artists.Any())
                    {
                        @for (int i = 0; i < item.Artists.Count; i++)
                        {
                            <a asp-controller="Artist"
                               asp-action="Details"
                               asp-route-id="@item.Artists[i].ArtistID"
                               style="color:#BF5700;">
                                @item.Artists[i].ArtistName
                            </a>
                            @if (i < item.Artists.Count - 1)
                            {
                                @:,
                            }
                        }
                    }
                </td>
                <td style="color:#BF5700;">@Html.DisplayFor(modelItem => item.Price)</td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.AlbumID"
                       class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Home" asp-action="Index" class="btn btn-secondary mt-2">Home</a>